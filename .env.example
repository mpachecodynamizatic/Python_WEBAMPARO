# Variables de entorno para Protectora Burjassot

# Entorno (development o production)
FLASK_ENV=development

# Clave secreta (CAMBIAR en producción)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_en_produccion_por_clave_segura

# Base de datos
# Desarrollo: sqlite:///protectora.db
# Producción: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///protectora.db

# Puerto (Railway lo asigna automáticamente)
PORT=5000

# CORS (dominios permitidos separados por comas)
# Desarrollo: *
# Producción: https://tudominio.com,https://www.tudominio.com
CORS_ORIGINS=*

# Python
PYTHONUNBUFFERED=1

# Debug (solo desarrollo)
FLASK_DEBUG=false
